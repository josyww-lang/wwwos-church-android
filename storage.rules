rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Looks up the admin list in the database.
    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Photos in chat: only the people in that conversation can see them or add one.
    // Pictures are shrunk by the app before they are sent (under 2 MB).
    match /chat/{roomId}/{fileName} {
      function inRoom() {
        return request.auth.uid in firestore.get(/databases/(default)/documents/chatRooms/$(roomId)).data.memberIds;
      }
      allow read: if isSignedIn() && (inRoom() || isAdmin());
      allow create: if isSignedIn() && inRoom()
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && (inRoom() || isAdmin());
    }

    // Sermon audio: members can listen. Only admins can upload (audio files under 100 MB) or delete.
    match /sermons/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
                            && request.resource.size < 100 * 1024 * 1024
                            && request.resource.contentType.matches('audio/.*');
      allow delete: if isAdmin();
    }
  }
}

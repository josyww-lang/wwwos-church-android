{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/bibleBooks",
        "function": {
          "functionId": "bibleBooks",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/bibleChapter",
        "function": {
          "functionId": "bibleChapter",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/bibleSearch",
        "function": {
          "functionId": "bibleSearch",
          "region": "europe-west1"
        }
      }
    ]
  }
}

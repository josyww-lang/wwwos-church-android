# Copy this file to a new file named exactly ".env" (in the same "functions" folder) and fill in both lines.
# They let the server notice when your YouTube channel goes live. Leave them out to switch that off.
YOUTUBE_API_KEY=paste-your-api-key-here
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# The verse of the day in English, Norsk and Afaan Oromoo from API.Bible (free key from https://api.bible, "Starter" plan).
# The same verse is fetched in all three languages. Find the Bible IDs with:  node tools/apibible-check.js
# Leave these out and only the English verse (from bible-api.com) is written.
APIBIBLE_KEY=paste-your-api-key-here
APIBIBLE_ID_EN=paste-the-english-bible-id
APIBIBLE_ID_NB=paste-the-norwegian-bible-id
APIBIBLE_ID_OM=paste-the-afaan-oromoo-bible-id

# Which languages decide the verse of the day. The verse is chosen only from books these Bibles have, and every language shows
# the same verse. A language not listed here (Norsk, when its Bible has only the New Testament) shows its own text when its
# Bible has the verse, and the English text of the same verse otherwise. Use "en,nb,om" to make all three decide (then the
# verse comes only from books all three Bibles have, for example only the New Testament).
APIBIBLE_PICK_FROM=en,om

# The Bible reader keeps each chapter it fetches in Firestore (so the API.Bible monthly limit is not used up). Set to "off" to
# fetch every time (then many readers can use up the monthly limit).
APIBIBLE_CACHE=on

# Norsk (the whole Bible: Bibel 1930) from the YouVersion Platform, free for non-commercial church apps.
# Get the App Key at platform.youversion.com (Apps). 121 is Bibel 1930. When both are set, Norsk uses this instead of API.Bible.
YVP_APP_KEY=paste-your-youversion-app-key-here
YVP_BIBLE_ID_NB=121

# Testing the 9:02 verse notification: only these people (user ids, separated by commas) get it. Leave it empty for everyone.
VERSE_REMINDER_ONLY=
